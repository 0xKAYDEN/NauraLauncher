<Window x:Class="NauraLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ctrl="clr-namespace:NauraLauncher.Controls"
        xmlns:cmn="clr-namespace:NauraLauncher.Common"
        xmlns:vm="clr-namespace:NauraLauncher.ViewModels"
        xmlns:views="clr-namespace:NauraLauncher.Views"
        mc:Ignorable="d"
        Title="NauraLauncher — Conquer Online"
        Width="1560" Height="1000"
        MinWidth="1200" MinHeight="820"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        FontFamily="{DynamicResource BodyFont}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        WindowStyle="None" AllowsTransparency="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="72" CornerRadius="16" GlassFrameThickness="0"
                      ResizeBorderThickness="6" />
    </WindowChrome.WindowChrome>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Border x:Name="RootBorder" Background="{DynamicResource BackgroundBrush}" CornerRadius="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0" Height="72" Margin="28,0,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Logo cluster - Conquer Online themed -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="10"
                            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                            Background="#2634D399" Margin="0,0,12,0">
                        <ctrl:IconControl Data="{StaticResource Icon.Dragon}"
                                          Brush="{DynamicResource AccentBrush}"
                                          StrokeWidth="1.6" Width="20" Height="20"/>
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="NAURA" FontSize="20" FontWeight="Bold"
                                   FontFamily="{DynamicResource DisplayFont}"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                        <TextBlock Text="CONQUER ONLINE" FontSize="9" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Margin="0,-2,0,0"/>
                    </StackPanel>

                    <Border Style="{StaticResource Badge}" Margin="16,0,0,0" Padding="10,5"
                            Background="{DynamicResource MutedBrush}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding AppVersion}" Style="{StaticResource Label}"
                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                            <Ellipse Width="5" Height="5" Fill="{DynamicResource AccentBrush}"
                                     Margin="9,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Ping}" Style="{StaticResource Label}"
                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Center nav pill -->
                <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="25" Padding="6,5"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolVis}}">
                    <ItemsControl ItemsSource="{Binding NavItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}"
                                        Command="{Binding DataContext.SelectNavCommand,
                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
                                            <Style.Triggers>
                                                <DataTrigger Value="True">
                                                    <DataTrigger.Binding>
                                                        <MultiBinding Converter="{x:Static cmn:EqualityConverter.Instance}">
                                                            <Binding/>
                                                            <Binding Path="DataContext.SelectedNav"
                                                                     RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        </MultiBinding>
                                                    </DataTrigger.Binding>
                                                    <Setter Property="Background" Value="{DynamicResource ElevatedBrush}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- Right cluster -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True">

                    <!-- Search - only when authenticated -->
                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="20" Width="220" Height="40" Margin="0,0,12,0"
                            Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolVis}}">
                        <Grid Margin="14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ctrl:IconControl Grid.Column="0" Data="{StaticResource Icon.Search}"
                                              Brush="{DynamicResource MutedForegroundBrush}"
                                              StrokeWidth="1.8" Width="16" Height="16" Margin="0,0,10,0"/>
                            <Grid Grid.Column="1">
                                <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0"
                                         VerticalContentAlignment="Center"
                                         Foreground="{DynamicResource ForegroundBrush}"
                                         CaretBrush="{DynamicResource ForegroundBrush}" FontSize="13"/>
                                <TextBlock Text="Search market..." IsHitTestVisible="False"
                                           VerticalAlignment="Center" FontSize="13"
                                           Foreground="{DynamicResource SubtleForegroundBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Wallet - CPs, Gold, Silver -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolVis}}">
                        <!-- CPs -->
                        <Border Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="20" Height="40" Padding="14,0" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ctrl:IconControl Data="{StaticResource Icon.Gem}" Brush="{DynamicResource AccentBrush}" Width="14" Height="14" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding CpsDisplay}" FontWeight="Bold" FontSize="12"
                                           FontFamily="{DynamicResource MonoFont}"
                                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Gold -->
                        <Border Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="20" Height="40" Padding="14,0" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ctrl:IconControl Data="{StaticResource Icon.Gold}" Brush="#FFF5A524" Width="14" Height="14" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding GoldDisplay}" FontWeight="Bold" FontSize="12"
                                           FontFamily="{DynamicResource MonoFont}"
                                           Foreground="#FFF5A524" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- User area with dropdown -->
                    <Grid>
                        <Border Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                                CornerRadius="25" Height="46" Padding="6,4,14,4"
                                Cursor="Hand"
                                Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolVis}}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="34" Height="34" CornerRadius="12" Margin="0,0,10,0">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding AvatarPath}" Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding UserName}" FontWeight="Bold" FontSize="12"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}"
                                                 VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding UserLevel}" Style="{StaticResource Label}"
                                                   Foreground="{DynamicResource MutedForegroundBrush}" FontSize="10"/>
                                    </StackPanel>
                                </StackPanel>
                                <ctrl:IconControl Data="{StaticResource Icon.ChevronDown}" Brush="{DynamicResource MutedForegroundBrush}" Width="14" Height="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Invisible button for click area -->
                        <Button Opacity="0" Command="{Binding ShowUserMenuCommand}" Cursor="Hand"
                                Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolVis}}"/>

                        <!-- User dropdown menu -->
                        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                                CornerRadius="14" Padding="8" Width="220"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,54,0,0"
                                Visibility="{Binding IsUserMenuOpen, Converter={StaticResource BoolVis}}">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" Opacity="0.5" BlurRadius="20" ShadowDepth="4"/>
                            </Border.Effect>
                            <StackPanel>
                                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Margin="0,0,12,0">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding AvatarPath}" Stretch="UniformToFill"/>
                                            </Border.Background>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding UserName}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource ForegroundBrush}"/>
                                            <TextBlock Text="{Binding UserClass}" Style="{StaticResource Label}" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Button Style="{StaticResource Button.Ghost}" Padding="12,10" HorizontalContentAlignment="Left" Command="{Binding ShowProfileCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <ctrl:IconControl Data="{StaticResource Icon.User}" Brush="{DynamicResource ForegroundBrush}" Width="16" Height="16" Margin="0,0,12,0"/>
                                        <TextBlock Text="PROFILE" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ForegroundBrush}"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource Button.Ghost}" Padding="12,10" HorizontalContentAlignment="Left" Command="{Binding ShowInventoryCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <ctrl:IconControl Data="{StaticResource Icon.Inventory}" Brush="{DynamicResource ForegroundBrush}" Width="16" Height="16" Margin="0,0,12,0"/>
                                        <TextBlock Text="INVENTORY" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ForegroundBrush}"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource Button.Ghost}" Padding="12,10" HorizontalContentAlignment="Left" Command="{Binding SelectNavCommand}" CommandParameter="Friends">
                                    <StackPanel Orientation="Horizontal">
                                        <ctrl:IconControl Data="{StaticResource Icon.Users}" Brush="{DynamicResource ForegroundBrush}" Width="16" Height="16" Margin="0,0,12,0"/>
                                        <TextBlock Text="FRIENDS &amp; VOICE" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ForegroundBrush}"/>
                                    </StackPanel>
                                </Button>

                                <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,8"/>

                                <Button Style="{StaticResource Button.Ghost}" Padding="12,10" HorizontalContentAlignment="Left" Command="{Binding LogoutCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <ctrl:IconControl Data="{StaticResource Icon.Logout}" Brush="{DynamicResource DestructiveBrush}" Width="16" Height="16" Margin="0,0,12,0"/>
                                        <TextBlock Text="LOGOUT" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource DestructiveBrush}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Window controls -->
                    <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                        <Button x:Name="MinBtn" Click="MinBtn_Click" Style="{StaticResource Button.Icon}"
                                Width="30" Height="30" Margin="0,0,6,0" ToolTip="Minimize">
                            <Rectangle Width="10" Height="1.5" Fill="{DynamicResource MutedForegroundBrush}"/>
                        </Button>
                        <Button x:Name="MaxBtn" Click="MaxBtn_Click" Style="{StaticResource Button.Icon}"
                                Width="30" Height="30" Margin="0,0,6,0" ToolTip="Maximize">
                            <Rectangle Width="10" Height="10" Stroke="{DynamicResource MutedForegroundBrush}"
                                       StrokeThickness="1.5" RadiusX="2" RadiusY="2"/>
                        </Button>
                        <Button x:Name="CloseBtn" Click="CloseBtn_Click" Style="{StaticResource Button.Icon}"
                                Width="30" Height="30" ToolTip="Close">
                            <Path Data="M0,0 L9,9 M9,0 L0,9" Stroke="{DynamicResource MutedForegroundBrush}"
                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- PAGE HOST -->
            <Grid Grid.Row="1">
                <!-- Auth Page - shown when not authenticated -->
                <Grid Visibility="{Binding IsAuth, Converter={StaticResource BoolVis}}">
                    <views:AuthPage DataContext="{Binding Auth}" />
                </Grid>

                <!-- Authenticated pages -->
                <Grid Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolVis}}">
                    <Grid Visibility="{Binding IsHome, Converter={StaticResource BoolVis}}">
                        <views:HomePage DataContext="{Binding Home}" />
                    </Grid>

                    <Grid Visibility="{Binding IsMarketplace, Converter={StaticResource BoolVis}}">
                        <views:MarketplacePage DataContext="{Binding Marketplace}" />
                    </Grid>

                    <Grid Visibility="{Binding IsAuction, Converter={StaticResource BoolVis}}">
                        <views:AuctionPage DataContext="{Binding Auction}" />
                    </Grid>

                    <Grid Visibility="{Binding IsFriends, Converter={StaticResource BoolVis}}">
                        <views:FriendsPage DataContext="{Binding Friends}" />
                    </Grid>

                    <Grid Visibility="{Binding IsSettings, Converter={StaticResource BoolVis}}">
                        <views:SettingsPage DataContext="{Binding Settings}" />
                    </Grid>

                    <Grid Visibility="{Binding IsProfile, Converter={StaticResource BoolVis}}">
                        <views:ProfilePage DataContext="{Binding Profile}" />
                    </Grid>

                    <Grid Visibility="{Binding IsInventory, Converter={StaticResource BoolVis}}">
                        <views:InventoryPage DataContext="{Binding Inventory}" />
                    </Grid>
                </Grid>

                <!-- Overlay to close user menu when clicking outside -->
                <Border Background="Transparent" Visibility="{Binding IsUserMenuOpen, Converter={StaticResource BoolVis}}">
                    <Button Opacity="0" Command="{Binding CloseUserMenuCommand}"/>
                </Border>
            </Grid>

            <!-- STATUS BAR -->
            <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                    Padding="28,0" Height="46" Margin="0,18,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ctrl:IconControl Data="{StaticResource Icon.Dragon}"
                                          Brush="{DynamicResource AccentBrush}"
                                          StrokeWidth="1.8" Width="16" Height="16" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding SystemState}" Style="{StaticResource Label}"
                                   Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"
                                   VerticalAlignment="Center"/>

                        <Rectangle Width="1" Height="16" Fill="{DynamicResource BorderBrush}" Margin="20,0"/>

                        <ctrl:IconControl Data="{StaticResource Icon.Gold}"
                                          Brush="{DynamicResource MutedForegroundBrush}"
                                          StrokeWidth="1.8" Width="15" Height="15" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding PatchLabel}" Style="{StaticResource Label}"
                                   Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                        <Border Style="{StaticResource ProgressTrack}" Width="150">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding PatchProgress, Converter={StaticResource PctGrid}}"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource ProgressFill}"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding PatchPercent}" Style="{StaticResource Label}"
                                   Foreground="{DynamicResource ForegroundBrush}" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <ctrl:IconControl Data="{StaticResource Icon.Phone}"
                                          Brush="{DynamicResource MutedForegroundBrush}"
                                          StrokeWidth="1.8" Width="14" Height="14" Margin="0,0,8,0"/>
                        <TextBlock Text="VOICE SERVER ACTIVE" Style="{StaticResource Label}"
                                   Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"/>

                        <Rectangle Width="1" Height="16" Fill="{DynamicResource BorderBrush}" Margin="20,0"/>

                        <ctrl:IconControl Data="{StaticResource Icon.Users}"
                                          Brush="{DynamicResource MutedForegroundBrush}"
                                          StrokeWidth="1.8" Width="14" Height="14" Margin="0,0,8,0"/>
                        <TextBlock Text="GUILD VOICE READY" Style="{StaticResource Label}"
                                   Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"/>

                        <Rectangle Width="1" Height="16" Fill="{DynamicResource BorderBrush}" Margin="20,0"/>

                        <ctrl:IconControl Data="{StaticResource Icon.CheckCircle}"
                                          Brush="{DynamicResource MutedForegroundBrush}"
                                          StrokeWidth="1.8" Width="15" Height="15" Margin="0,0,8,0"/>
                        <TextBlock Text="TWIN CITY SYNCED" Style="{StaticResource Label}"
                                   Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
