<Window x:Class="NauraLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ctrl="clr-namespace:NauraLauncher.Controls"
        xmlns:cmn="clr-namespace:NauraLauncher.Common"
        xmlns:vm="clr-namespace:NauraLauncher.ViewModels"
        xmlns:views="clr-namespace:NauraLauncher.Views"
        mc:Ignorable="d"
        Title="APEX — NauraLauncher"
        Width="1560" Height="1000"
        MinWidth="1200" MinHeight="820"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        FontFamily="{DynamicResource BodyFont}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        WindowStyle="None" AllowsTransparency="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="72" CornerRadius="16" GlassFrameThickness="0"
                      ResizeBorderThickness="6" />
    </WindowChrome.WindowChrome>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <!-- The root border paints the background AND owns the 16px corner clip.
         MainWindow.xaml.cs squares both off while the window is maximized. -->
    <Border x:Name="RootBorder" Background="{DynamicResource BackgroundBrush}" CornerRadius="16">
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />   <!-- header (persistent) -->
                <RowDefinition Height="*" />      <!-- page host -->
                <RowDefinition Height="Auto" />   <!-- status bar (persistent) -->
            </Grid.RowDefinitions>

            <!-- ============================================================
                 HEADER  (persistent across every page)
                 ============================================================ -->
            <Grid Grid.Row="0" Height="72" Margin="28,0,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />   <!-- logo -->
                    <ColumnDefinition Width="*" />      <!-- nav (centered) -->
                    <ColumnDefinition Width="Auto" />   <!-- right cluster -->
                </Grid.ColumnDefinitions>

                <!-- Logo cluster -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="0,0,20,0">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource SubtleForegroundBrush}" Margin="0,0,6,0"/>
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource SubtleForegroundBrush}" Margin="0,0,6,0"/>
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource SubtleForegroundBrush}"/>
                    </StackPanel>

                    <Border Width="30" Height="30" CornerRadius="8"
                            BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                            Background="{DynamicResource MutedBrush}" Margin="0,0,10,0">
                        <ctrl:IconControl Data="{StaticResource Icon.Target}"
                                          Brush="{DynamicResource ForegroundBrush}"
                                          StrokeWidth="1.6" Width="18" Height="18"/>
                    </Border>

                    <TextBlock Text="APEX" FontSize="21" FontWeight="Bold"
                               FontFamily="{DynamicResource DisplayFont}"
                               Foreground="{DynamicResource ForegroundBrush}"
                               VerticalAlignment="Center"/>

                    <!-- version pill -->
                    <Border Style="{StaticResource Badge}" Margin="16,0,0,0" Padding="10,5"
                            Background="{DynamicResource MutedBrush}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding AppVersion}" Style="{StaticResource Label}"
                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                            <Ellipse Width="5" Height="5" Fill="{DynamicResource AccentBrush}"
                                     Margin="9,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Ping}" Style="{StaticResource Label}"
                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Center nav pill -->
                <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="25" Padding="6,5"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <ItemsControl ItemsSource="{Binding NavItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}"
                                        Command="{Binding DataContext.SelectNavCommand,
                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
                                            <Style.Triggers>
                                                <DataTrigger Value="True">
                                                    <DataTrigger.Binding>
                                                        <MultiBinding Converter="{x:Static cmn:EqualityConverter.Instance}">
                                                            <Binding/>
                                                            <Binding Path="DataContext.SelectedNav"
                                                                     RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        </MultiBinding>
                                                    </DataTrigger.Binding>
                                                    <Setter Property="Background" Value="{DynamicResource ElevatedBrush}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- Right cluster: search + credits + user + window buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True">

                    <!-- Search -->
                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="20" Width="240" Height="40" Margin="0,0,14,0">
                        <Grid Margin="14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ctrl:IconControl Grid.Column="0" Data="{StaticResource Icon.Search}"
                                              Brush="{DynamicResource MutedForegroundBrush}"
                                              StrokeWidth="1.8" Width="16" Height="16" Margin="0,0,10,0"/>
                            <Grid Grid.Column="1">
                                <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0"
                                         VerticalContentAlignment="Center"
                                         Foreground="{DynamicResource ForegroundBrush}"
                                         CaretBrush="{DynamicResource ForegroundBrush}" FontSize="13"/>
                                <TextBlock Text="Search gallery..." IsHitTestVisible="False"
                                           VerticalAlignment="Center" FontSize="13"
                                           Foreground="{DynamicResource SubtleForegroundBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Credits -->
                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="20" Height="40" Padding="16,0" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="CREDITS" Style="{StaticResource Label}"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Credits}" FontWeight="Bold" FontSize="13"
                                       FontFamily="{DynamicResource MonoFont}"
                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- User -->
                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                            CornerRadius="25" Height="46" Padding="6,4,16,4">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="36" Height="36" CornerRadius="15" Margin="0,0,10,0">
                                <Border.Background>
                                    <ImageBrush ImageSource="Assets/avatar.png" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding UserName}" FontWeight="Bold" FontSize="12"
                                           Foreground="{DynamicResource ForegroundBrush}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}"
                                             VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding UserState}" Style="{StaticResource Label}"
                                               Foreground="{DynamicResource MutedForegroundBrush}" FontSize="10"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Window controls -->
                    <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                        <Button x:Name="MinBtn" Click="MinBtn_Click" Style="{StaticResource Button.Icon}"
                                Width="30" Height="30" Margin="0,0,6,0" ToolTip="Minimize">
                            <Rectangle Width="10" Height="1.5" Fill="{DynamicResource MutedForegroundBrush}"/>
                        </Button>
                        <Button x:Name="MaxBtn" Click="MaxBtn_Click" Style="{StaticResource Button.Icon}"
                                Width="30" Height="30" Margin="0,0,6,0" ToolTip="Maximize">
                            <Rectangle Width="10" Height="10" Stroke="{DynamicResource MutedForegroundBrush}"
                                       StrokeThickness="1.5" RadiusX="2" RadiusY="2"/>
                        </Button>
                        <Button x:Name="CloseBtn" Click="CloseBtn_Click" Style="{StaticResource Button.Icon}"
                                Width="30" Height="30" ToolTip="Close">
                            <Path Data="M0,0 L9,9 M9,0 L0,9" Stroke="{DynamicResource MutedForegroundBrush}"
                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- ============================================================
                 PAGE HOST : one page per nav tab, swapped by Visibility.
                 Each wrapper Grid inherits the shell DataContext so it can
                 read IsHome / IsMarketplace / IsAuction / IsSettings, while
                 the page itself is re-scoped to its own sub view model.
                 ============================================================ -->
            <Grid Grid.Row="1">
                <Grid Visibility="{Binding IsHome, Converter={StaticResource BoolVis}}">
                    <views:HomePage DataContext="{Binding Home}" />
                </Grid>

                <Grid Visibility="{Binding IsMarketplace, Converter={StaticResource BoolVis}}">
                    <views:MarketplacePage DataContext="{Binding Marketplace}" />
                </Grid>

                <Grid Visibility="{Binding IsAuction, Converter={StaticResource BoolVis}}">
                    <views:AuctionPage DataContext="{Binding Auction}" />
                </Grid>

                <Grid Visibility="{Binding IsSettings, Converter={StaticResource BoolVis}}">
                    <views:SettingsPage DataContext="{Binding Settings}" />
                </Grid>
            </Grid>

            <!-- ============================================================
                 STATUS BAR  (persistent across every page)
                 ============================================================ -->
            <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                    Padding="28,0" Height="46" Margin="0,18,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ctrl:IconControl Data="{StaticResource Icon.CheckCircle}"
                                          Brush="{DynamicResource AccentBrush}"
                                          StrokeWidth="1.8" Width="16" Height="16" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding SystemState}" Style="{StaticResource Label}"
                                   Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"
                                   VerticalAlignment="Center"/>

                        <Rectangle Width="1" Height="16" Fill="{DynamicResource BorderBrush}" Margin="20,0"/>

                        <ctrl:IconControl Data="{StaticResource Icon.Download}"
                                          Brush="{DynamicResource MutedForegroundBrush}"
                                          StrokeWidth="1.8" Width="15" Height="15" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding PatchLabel}" Style="{StaticResource Label}"
                                   Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                        <Border Style="{StaticResource ProgressTrack}" Width="150">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding PatchProgress, Converter={StaticResource PctGrid}}"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource ProgressFill}"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding PatchPercent}" Style="{StaticResource Label}"
                                   Foreground="{DynamicResource ForegroundBrush}" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <ctrl:IconControl Data="{StaticResource Icon.Mic}"
                                          Brush="{DynamicResource MutedForegroundBrush}"
                                          StrokeWidth="1.8" Width="14" Height="14" Margin="0,0,8,0"/>
                        <TextBlock Text="COMM LINK ACTIVE" Style="{StaticResource Label}"
                                   Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"/>

                        <Rectangle Width="1" Height="16" Fill="{DynamicResource BorderBrush}" Margin="20,0"/>

                        <ctrl:IconControl Data="{StaticResource Icon.Headphones}"
                                          Brush="{DynamicResource MutedForegroundBrush}"
                                          StrokeWidth="1.8" Width="14" Height="14" Margin="0,0,8,0"/>
                        <TextBlock Text="SURROUND 7.1" Style="{StaticResource Label}"
                                   Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"/>

                        <Rectangle Width="1" Height="16" Fill="{DynamicResource BorderBrush}" Margin="20,0"/>

                        <ctrl:IconControl Data="{StaticResource Icon.Cloud}"
                                          Brush="{DynamicResource MutedForegroundBrush}"
                                          StrokeWidth="1.8" Width="15" Height="15" Margin="0,0,8,0"/>
                        <TextBlock Text="CLOUD SYNCED" Style="{StaticResource Label}"
                                   Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
