<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ================================================================
         DESIGN TOKENS  (shadcn/ui "zinc" dark palette, tuned to APEX)
         All colors are HSL-derived, dark-first.
         ================================================================ -->

    <!-- Backgrounds -->
    <Color x:Key="BackgroundColor">#FF07080A</Color>       <!-- app root -->
    <Color x:Key="SurfaceColor">#FF0D0F12</Color>          <!-- panels / status bar -->
    <Color x:Key="CardColor">#FF121418</Color>             <!-- card surface -->
    <Color x:Key="CardHoverColor">#FF181B20</Color>
    <Color x:Key="MutedColor">#FF1B1E24</Color>            <!-- muted fills / inputs -->
    <Color x:Key="ElevatedColor">#FF20242B</Color>

    <!-- Foreground / text -->
    <Color x:Key="ForegroundColor">#FFF4F5F7</Color>       <!-- primary text -->
    <Color x:Key="MutedForegroundColor">#FF8A8F99</Color>  <!-- secondary text -->
    <Color x:Key="SubtleForegroundColor">#FF5C616B</Color> <!-- tertiary / labels -->

    <!-- Borders -->
    <Color x:Key="BorderColor">#FF23262D</Color>
    <Color x:Key="BorderStrongColor">#FF313641</Color>
    <Color x:Key="RingColor">#FFE7E9EC</Color>             <!-- focus ring -->

    <!-- Accents -->
    <Color x:Key="PrimaryColor">#FFF4F5F7</Color>          <!-- primary (white) button -->
    <Color x:Key="PrimaryForegroundColor">#FF0A0B0D</Color>
    <Color x:Key="AccentColor">#FF34D399</Color>           <!-- emerald / live / positive -->
    <Color x:Key="AccentDimColor">#FF10B981</Color>
    <Color x:Key="DestructiveColor">#FFF87171</Color>

    <!-- ================================================================
         BRUSHES
         ================================================================ -->
    <SolidColorBrush x:Key="BackgroundBrush"        Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush"           Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="CardBrush"              Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="CardHoverBrush"         Color="{StaticResource CardHoverColor}" />
    <SolidColorBrush x:Key="MutedBrush"             Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="ElevatedBrush"          Color="{StaticResource ElevatedColor}" />

    <SolidColorBrush x:Key="ForegroundBrush"        Color="{StaticResource ForegroundColor}" />
    <SolidColorBrush x:Key="MutedForegroundBrush"   Color="{StaticResource MutedForegroundColor}" />
    <SolidColorBrush x:Key="SubtleForegroundBrush"  Color="{StaticResource SubtleForegroundColor}" />

    <SolidColorBrush x:Key="BorderBrush"            Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush"      Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="RingBrush"              Color="{StaticResource RingColor}" />

    <SolidColorBrush x:Key="PrimaryBrush"           Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryForegroundBrush" Color="{StaticResource PrimaryForegroundColor}" />
    <SolidColorBrush x:Key="AccentBrush"            Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentDimBrush"         Color="{StaticResource AccentDimColor}" />
    <SolidColorBrush x:Key="DestructiveBrush"       Color="{StaticResource DestructiveColor}" />

    <!-- Radii (shadcn default radius scale) -->
    <CornerRadius x:Key="RadiusSm">6</CornerRadius>
    <CornerRadius x:Key="RadiusMd">10</CornerRadius>
    <CornerRadius x:Key="RadiusLg">14</CornerRadius>
    <CornerRadius x:Key="RadiusXl">18</CornerRadius>
    <CornerRadius x:Key="RadiusFull">999</CornerRadius>

    <!-- Numeric radius doubles for pill controls -->
    <sys:Double x:Key="RadiusPill">999</sys:Double>

</ResourceDictionary>
