<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:cmn="clr-namespace:NauraLauncher.Common">

    <!-- ================================================================
         SHARED CONVERTER INSTANCES
         Declared once at application scope so every page can use
         {StaticResource BoolVis} etc. without re-declaring them.
         ================================================================ -->

    <cmn:StringToVisibilityConverter x:Key="StrVis" />
    <cmn:BoolToVisibilityConverter x:Key="BoolVis" />
    <cmn:PercentToGridLengthConverter x:Key="PctGrid" />
    <cmn:ParameterMatchConverter x:Key="ParamMatch" />
    <cmn:ParameterMatchToVisibilityConverter x:Key="ParamMatchVis" />
    <cmn:StringToBrushConverter x:Key="HexBrush" />
    <cmn:IconKeyConverter x:Key="IconKey" />
    <cmn:EqualityConverter x:Key="Equal" />

</ResourceDictionary>
