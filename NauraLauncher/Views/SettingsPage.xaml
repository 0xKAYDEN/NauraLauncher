<UserControl x:Class="NauraLauncher.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ctrl="clr-namespace:NauraLauncher.Controls"
             xmlns:cmn="clr-namespace:NauraLauncher.Common"
             xmlns:vm="clr-namespace:NauraLauncher.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="880" d:DesignWidth="1504"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">

    <UserControl.Resources>

        <!-- ===== shadcn Switch row ===== -->
        <DataTemplate x:Key="SwitchRow">
            <Border Style="{StaticResource Row}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource Label}" FontSize="12"
                                       FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}"/>
                            <Border Style="{StaticResource Badge}" Padding="7,3" Margin="9,0,0,0"
                                    Background="{DynamicResource SurfaceBrush}"
                                    Visibility="{Binding RequiresRestart, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="RESTART" Style="{StaticResource Label}" FontSize="9"
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" FontSize="12" Margin="0,6,0,0"
                                   Foreground="{DynamicResource MutedForegroundBrush}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <ToggleButton Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                  IsChecked="{Binding IsOn, Mode=TwoWay}"
                                  ToolTip="{Binding Name}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ===== shadcn Slider row ===== -->
        <DataTemplate x:Key="SliderRow">
            <Border Style="{StaticResource Row}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <StackPanel Margin="0,0,120,0">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource Label}" FontSize="12"
                                       FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}"/>
                            <TextBlock Text="{Binding Description}" FontSize="12" Margin="0,6,0,0"
                                       Foreground="{DynamicResource MutedForegroundBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock Text="{Binding ValueLabel}" HorizontalAlignment="Right" FontSize="15"
                                   FontWeight="Bold" FontFamily="{DynamicResource MonoFont}"
                                   Foreground="{DynamicResource AccentBrush}"/>
                    </Grid>

                    <Slider Grid.Row="1" Style="{StaticResource Slider}"
                            Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                            TickFrequency="{Binding TickFrequency}" IsSnapToTickEnabled="True"
                            Value="{Binding Value, Mode=TwoWay}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ===== group card shell ===== -->
        <Style x:Key="GroupCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="24,20"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
        </Style>

        <Style x:Key="GroupTitle" TargetType="TextBlock" BasedOn="{StaticResource PanelTitle}">
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="28,6,28,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="256"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================================================
             SECTIONS RAIL
             ============================================================ -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16,18" VerticalAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="6,0,0,18">
                    <TextBlock Text="CONFIGURATION" Style="{StaticResource PanelTitle}"/>
                    <TextBlock Text="{Binding BuildLabel}" Style="{StaticResource Label}" Margin="0,7,0,0"
                               Foreground="{DynamicResource SubtleForegroundBrush}" TextWrapping="Wrap"/>
                </StackPanel>

                <ItemsControl Grid.Row="1" ItemsSource="{Binding Sections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="0,0,0,4" Cursor="Hand" HorizontalContentAlignment="Stretch"
                                    Command="{Binding DataContext.SelectSectionCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
                                        <Setter Property="Padding" Value="12,11"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource ElevatedBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ctrl:IconControl Grid.Column="0"
                                                      Data="{Binding IconKey, Converter={x:Static cmn:IconKeyConverter.Instance}}"
                                                      Brush="{DynamicResource MutedForegroundBrush}"
                                                      StrokeWidth="1.8" Width="17" Height="17" Margin="0,0,12,0"
                                                      VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Label}"
                                               FontSize="12" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Label}">
                                                <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Column="2" Text="{Binding Hint}" Style="{StaticResource Label}"
                                               FontSize="9" VerticalAlignment="Center"
                                               Visibility="{Binding Hint, Converter={StaticResource StrVis}}"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Grid.Row="2" Margin="0,18,0,0">
                    <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,0,0,14"/>
                    <Button Style="{StaticResource Button.Outline}" Padding="14,10" Cursor="Hand"
                            HorizontalContentAlignment="Stretch"
                            Command="{Binding ResetCommand}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ctrl:IconControl Data="{StaticResource Icon.Refresh}"
                                              Brush="{DynamicResource ForegroundBrush}"
                                              StrokeWidth="1.8" Width="14" Height="14" Margin="0,0,9,0"/>
                            <TextBlock Text="RESET TO DEFAULTS" Style="{StaticResource Label}" FontWeight="Bold"
                                       FontSize="11" Foreground="{DynamicResource ForegroundBrush}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================
             SECTION PANES
             ============================================================ -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,10,24">

                <!-- Pane header -->
                <Grid Margin="2,0,0,20">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedSectionName}" Style="{StaticResource SectionTitle}"
                                   FontSize="26"/>
                        <TextBlock Text="{Binding SelectedSectionHint}" Style="{StaticResource Label}"
                                   Margin="1,8,0,0" Foreground="{DynamicResource MutedForegroundBrush}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding ProfilePath}" Style="{StaticResource Label}"
                               FontFamily="{DynamicResource MonoFont}"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <!-- ===================== GENERAL ===================== -->
                <StackPanel Visibility="{Binding SelectedSectionId, Converter={StaticResource ParamMatchVis}, ConverterParameter=general}">
                    <Border Style="{StaticResource GroupCard}">
                        <StackPanel>
                            <TextBlock Text="CLIENT &amp; UPDATES" Style="{StaticResource GroupTitle}"/>
                            <ItemsControl ItemsSource="{Binding GeneralSwitches}"
                                          ItemTemplate="{StaticResource SwitchRow}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GroupCard}">
                        <StackPanel>
                            <TextBlock Text="SCALING" Style="{StaticResource GroupTitle}"/>
                            <ItemsControl ItemsSource="{Binding GeneralSliders}"
                                          ItemTemplate="{StaticResource SliderRow}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===================== VIDEO ===================== -->
                <StackPanel Visibility="{Binding SelectedSectionId, Converter={StaticResource ParamMatchVis}, ConverterParameter=video}">
                    <Border Style="{StaticResource GroupCard}">
                        <StackPanel>
                            <TextBlock Text="PRESENTATION" Style="{StaticResource GroupTitle}"/>
                            <TextBlock Text="How the client presents to the desktop compositor."
                                       FontSize="12" Margin="0,0,0,16"
                                       Foreground="{DynamicResource MutedForegroundBrush}"/>

                            <!-- segmented control -->
                            <Border Style="{StaticResource Segmented.Container}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segmented.Item}" GroupName="DisplayMode"
                                                 Content="WINDOWED"
                                                 IsChecked="{Binding DisplayMode, Mode=TwoWay,
                                                             Converter={StaticResource ParamMatch},
                                                             ConverterParameter=WINDOWED}"/>
                                    <RadioButton Style="{StaticResource Segmented.Item}" GroupName="DisplayMode"
                                                 Content="BORDERLESS"
                                                 IsChecked="{Binding DisplayMode, Mode=TwoWay,
                                                             Converter={StaticResource ParamMatch},
                                                             ConverterParameter=BORDERLESS}"/>
                                    <RadioButton Style="{StaticResource Segmented.Item}" GroupName="DisplayMode"
                                                 Content="FULLSCREEN"
                                                 IsChecked="{Binding DisplayMode, Mode=TwoWay,
                                                             Converter={StaticResource ParamMatch},
                                                             ConverterParameter=FULLSCREEN}"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{Binding DisplayMode}" Style="{StaticResource Label}" Margin="0,14,0,0"
                                       FontFamily="{DynamicResource MonoFont}"
                                       Foreground="{DynamicResource AccentBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GroupCard}">
                        <StackPanel>
                            <TextBlock Text="RENDER PIPELINE" Style="{StaticResource GroupTitle}"/>
                            <ItemsControl ItemsSource="{Binding VideoSwitches}"
                                          ItemTemplate="{StaticResource SwitchRow}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GroupCard}">
                        <StackPanel>
                            <TextBlock Text="IMAGE QUALITY" Style="{StaticResource GroupTitle}"/>
                            <ItemsControl ItemsSource="{Binding VideoSliders}"
                                          ItemTemplate="{StaticResource SliderRow}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===================== AUDIO ===================== -->
                <StackPanel Visibility="{Binding SelectedSectionId, Converter={StaticResource ParamMatchVis}, ConverterParameter=audio}">
                    <Border Style="{StaticResource GroupCard}">
                        <StackPanel>
                            <TextBlock Text="MIX LEVELS" Style="{StaticResource GroupTitle}"/>
                            <ItemsControl ItemsSource="{Binding AudioSliders}"
                                          ItemTemplate="{StaticResource SliderRow}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GroupCard}">
                        <StackPanel>
                            <TextBlock Text="OUTPUT" Style="{StaticResource GroupTitle}"/>
                            <ItemsControl ItemsSource="{Binding AudioSwitches}"
                                          ItemTemplate="{StaticResource SwitchRow}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===================== INPUT ===================== -->
                <StackPanel Visibility="{Binding SelectedSectionId, Converter={StaticResource ParamMatchVis}, ConverterParameter=input}">
                    <Border Style="{StaticResource GroupCard}">
                        <StackPanel>
                            <TextBlock Text="ACTIVE SCHEME" Style="{StaticResource GroupTitle}"/>
                            <TextBlock Text="Bindings follow the active scheme."
                                       FontSize="12" Margin="0,0,0,16"
                                       Foreground="{DynamicResource MutedForegroundBrush}"/>

                            <Border Style="{StaticResource Segmented.Container}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segmented.Item}" GroupName="InputMode"
                                                 Content="MOUSE + KB"
                                                 IsChecked="{Binding InputMode, Mode=TwoWay,
                                                             Converter={StaticResource ParamMatch},
                                                             ConverterParameter='MOUSE + KB'}"/>
                                    <RadioButton Style="{StaticResource Segmented.Item}" GroupName="InputMode"
                                                 Content="CONTROLLER"
                                                 IsChecked="{Binding InputMode, Mode=TwoWay,
                                                             Converter={StaticResource ParamMatch},
                                                             ConverterParameter=CONTROLLER}"/>
                                    <RadioButton Style="{StaticResource Segmented.Item}" GroupName="InputMode"
                                                 Content="HYBRID"
                                                 IsChecked="{Binding InputMode, Mode=TwoWay,
                                                             Converter={StaticResource ParamMatch},
                                                             ConverterParameter=HYBRID}"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{Binding InputMode}" Style="{StaticResource Label}" Margin="0,14,0,0"
                                       FontFamily="{DynamicResource MonoFont}"
                                       Foreground="{DynamicResource AccentBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GroupCard}">
                        <StackPanel>
                            <TextBlock Text="TUNING" Style="{StaticResource GroupTitle}"/>
                            <ItemsControl ItemsSource="{Binding InputSliders}"
                                          ItemTemplate="{StaticResource SliderRow}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GroupCard}">
                        <StackPanel>
                            <TextBlock Text="BEHAVIOUR" Style="{StaticResource GroupTitle}"/>
                            <ItemsControl ItemsSource="{Binding InputSwitches}"
                                          ItemTemplate="{StaticResource SwitchRow}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===================== NETWORK ===================== -->
                <StackPanel Visibility="{Binding SelectedSectionId, Converter={StaticResource ParamMatchVis}, ConverterParameter=network}">
                    <Border Style="{StaticResource GroupCard}">
                        <StackPanel>
                            <TextBlock Text="TRANSPORT" Style="{StaticResource GroupTitle}"/>
                            <ItemsControl ItemsSource="{Binding NetworkSwitches}"
                                          ItemTemplate="{StaticResource SwitchRow}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GroupCard}">
                        <StackPanel>
                            <TextBlock Text="BANDWIDTH" Style="{StaticResource GroupTitle}"/>
                            <ItemsControl ItemsSource="{Binding NetworkSliders}"
                                          ItemTemplate="{StaticResource SliderRow}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===================== PRIVACY ===================== -->
                <StackPanel Visibility="{Binding SelectedSectionId, Converter={StaticResource ParamMatchVis}, ConverterParameter=privacy}">
                    <Border Style="{StaticResource GroupCard}">
                        <StackPanel>
                            <TextBlock Text="VISIBILITY" Style="{StaticResource GroupTitle}"/>
                            <ItemsControl ItemsSource="{Binding PrivacySwitches}"
                                          ItemTemplate="{StaticResource SwitchRow}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GroupCard}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="42" Height="42" CornerRadius="11" Background="#2634D399"
                                    Margin="0,0,14,0">
                                <ctrl:IconControl Data="{StaticResource Icon.Shield}"
                                                  Brush="{DynamicResource AccentBrush}"
                                                  StrokeWidth="1.7" Width="20" Height="20"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="VAULT CUSTODY" Style="{StaticResource Label}" FontSize="12"
                                           FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}"/>
                                <TextBlock Text="Auction lots are escrowed by APEX until the hammer falls."
                                           FontSize="12" Margin="0,6,0,0"
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
