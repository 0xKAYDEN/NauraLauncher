<UserControl x:Class="NauraLauncher.Views.ProfilePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ctrl="clr-namespace:NauraLauncher.Controls"
             xmlns:cmn="clr-namespace:NauraLauncher.Common"
             xmlns:vm="clr-namespace:NauraLauncher.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="880" d:DesignWidth="1504"
             d:DataContext="{d:DesignInstance Type=vm:ProfileViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,10,28,24">

            <!-- Header -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="96" Height="96" CornerRadius="24" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding AvatarPath}" Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>

                <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding DisplayName}" FontSize="28" FontWeight="Bold" FontFamily="{DynamicResource DisplayFont}" Foreground="{DynamicResource ForegroundBrush}"/>
                        <Border Style="{StaticResource Badge.Accent}" Margin="16,0,0,0" Padding="10,5" VerticalAlignment="Center">
                            <TextBlock Text="{Binding LevelDisplay}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                        <Border Style="{StaticResource Badge}" Margin="8,0,0,0" Padding="10,5" VerticalAlignment="Center" Background="{DynamicResource SurfaceBrush}">
                            <TextBlock Text="{Binding ClassDisplay}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ForegroundBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Username}" Style="{StaticResource Label}" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,6,0,0" FontFamily="{DynamicResource MonoFont}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Label}" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
                        <TextBlock Text="•" Margin="10,0" Foreground="{DynamicResource SubtleForegroundBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding RebornDisplay}" Style="{StaticResource Label}" Foreground="{DynamicResource MutedForegroundBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <Button Style="{StaticResource Button.Outline}" Padding="20,12">
                        <StackPanel Orientation="Horizontal">
                            <ctrl:IconControl Data="{StaticResource Icon.Settings}" Brush="{DynamicResource ForegroundBrush}" Width="16" Height="16" Margin="0,0,8,0"/>
                            <TextBlock Text="EDIT PROFILE" Style="{StaticResource Label}" FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Wallet Cards -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0" Padding="20,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" Background="#2634D399" Margin="0,0,14,0">
                            <ctrl:IconControl Data="{StaticResource Icon.Gem}" Brush="{DynamicResource AccentBrush}" Width="22" Height="22"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="CONQUER POINTS" Style="{StaticResource Label}" FontSize="11"/>
                            <TextBlock Text="{Binding CpsDisplay}" FontSize="20" FontWeight="Bold" FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource ForegroundBrush}" Margin="0,4,0,0"/>
                            <TextBlock Text="Premium currency" Style="{StaticResource Label}" FontSize="10" Foreground="{DynamicResource SubtleForegroundBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,12,0" Padding="20,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" Background="#33F5A524" Margin="0,0,14,0">
                            <ctrl:IconControl Data="{StaticResource Icon.Gold}" Brush="#FFF5A524" Width="22" Height="22"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="GOLD" Style="{StaticResource Label}" FontSize="11"/>
                            <TextBlock Text="{Binding GoldDisplay}" FontSize="20" FontWeight="Bold" FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource ForegroundBrush}" Margin="0,4,0,0"/>
                            <TextBlock Text="Trade currency" Style="{StaticResource Label}" FontSize="10" Foreground="{DynamicResource SubtleForegroundBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,12,0" Padding="20,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" Background="{DynamicResource MutedBrush}" Margin="0,0,14,0">
                            <ctrl:IconControl Data="{StaticResource Icon.Silver}" Brush="{DynamicResource MutedForegroundBrush}" Width="22" Height="22"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="SILVER" Style="{StaticResource Label}" FontSize="11"/>
                            <TextBlock Text="{Binding SilverDisplay}" FontSize="20" FontWeight="Bold" FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource ForegroundBrush}" Margin="0,4,0,0"/>
                            <TextBlock Text="Basic currency" Style="{StaticResource Label}" FontSize="10" Foreground="{DynamicResource SubtleForegroundBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource Card}" Padding="20,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" Background="#33C084FC" Margin="0,0,14,0">
                            <ctrl:IconControl Data="{StaticResource Icon.Gem}" Brush="#FFC084FC" Width="22" Height="22"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="BOUND CPs" Style="{StaticResource Label}" FontSize="11"/>
                            <TextBlock Text="{Binding BoundCpsDisplay}" FontSize="20" FontWeight="Bold" FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource ForegroundBrush}" Margin="0,4,0,0"/>
                            <TextBlock Text="Non-tradable" Style="{StaticResource Label}" FontSize="10" Foreground="{DynamicResource SubtleForegroundBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Stats and Info -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="400"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Stats -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="24,20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <ctrl:IconControl Data="{StaticResource Icon.Trophy}" Brush="{DynamicResource ForegroundBrush}" Width="18" Height="18" Margin="0,0,10,0"/>
                            <TextBlock Text="HERO STATISTICS" Style="{StaticResource PanelTitle}"/>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding Stats}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="{DynamicResource MutedBrush}" Margin="0,0,12,0">
                                                <ctrl:IconControl Data="{Binding IconKey, Converter={x:Static cmn:IconKeyConverter.Instance}}" Brush="{DynamicResource MutedForegroundBrush}" Width="18" Height="18"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Label}" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Value}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Margin="0,24,0,0">
                            <TextBlock Text="CLASS PROGRESSION" Style="{StaticResource Label}" FontWeight="Bold" Margin="0,0,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource Card}" Background="{DynamicResource SurfaceBrush}" Padding="12" CornerRadius="10">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="TROJAN" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock Text="Lv.120" Style="{StaticResource Label}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <ctrl:IconControl Grid.Column="1" Data="{StaticResource Icon.ArrowRight}" Brush="{DynamicResource MutedForegroundBrush}" Width="16" Height="16" Margin="8,0" VerticalAlignment="Center"/>

                                <Border Grid.Column="2" Style="{StaticResource Card}" Background="{DynamicResource SurfaceBrush}" Padding="12" CornerRadius="10">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="1ST REBORN" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" Foreground="{DynamicResource ForegroundBrush}"/>
                                        <TextBlock Text="Warrior" Style="{StaticResource Label}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <ctrl:IconControl Grid.Column="3" Data="{StaticResource Icon.ArrowRight}" Brush="{DynamicResource MutedForegroundBrush}" Width="16" Height="16" Margin="8,0" VerticalAlignment="Center"/>

                                <Border Grid.Column="4" Style="{StaticResource Card}" Background="#2634D399" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Padding="12" CornerRadius="10">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="2ND REBORN" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock Text="Trojan" Style="{StaticResource Label}" HorizontalAlignment="Center" Margin="0,4,0,0" Foreground="{DynamicResource AccentBrush}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Right: Quick actions -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="QUICK ACTIONS" Style="{StaticResource PanelTitle}" Margin="0,0,0,16"/>
                            <Button Style="{StaticResource Button.Primary}" Height="44" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <ctrl:IconControl Data="{StaticResource Icon.Inventory}" Brush="{DynamicResource PrimaryForegroundBrush}" Width="16" Height="16" Margin="0,0,8,0"/>
                                    <TextBlock Text="VIEW INVENTORY" FontWeight="Bold" FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Button.Outline}" Height="44" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <ctrl:IconControl Data="{StaticResource Icon.Users}" Brush="{DynamicResource ForegroundBrush}" Width="16" Height="16" Margin="0,0,8,0"/>
                                    <TextBlock Text="FRIEND LIST" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ForegroundBrush}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Button.Outline}" Height="44">
                                <StackPanel Orientation="Horizontal">
                                    <ctrl:IconControl Data="{StaticResource Icon.Gold}" Brush="{DynamicResource ForegroundBrush}" Width="16" Height="16" Margin="0,0,8,0"/>
                                    <TextBlock Text="TRADE HISTORY" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ForegroundBrush}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="20" Margin="0,16,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <ctrl:IconControl Data="{StaticResource Icon.Info}" Brush="{DynamicResource ForegroundBrush}" Width="16" Height="16" Margin="0,0,8,0"/>
                                <TextBlock Text="ACCOUNT INFO" Style="{StaticResource PanelTitle}"/>
                            </StackPanel>
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="Member Since" Style="{StaticResource Label}"/>
                                    <TextBlock Text="2021-06-15" Style="{StaticResource Label}" FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource ForegroundBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="Last Login" Style="{StaticResource Label}"/>
                                    <TextBlock Text="2 hours ago" Style="{StaticResource Label}" Foreground="{DynamicResource ForegroundBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="Server" Style="{StaticResource Label}"/>
                                    <TextBlock Text="Eternity" Style="{StaticResource Label}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Status" Style="{StaticResource Label}"/>
                                    <Border Style="{StaticResource Badge.Accent}" Padding="8,3" HorizontalAlignment="Right">
                                        <TextBlock Text="VERIFIED HERO" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
