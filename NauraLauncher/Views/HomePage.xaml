<UserControl x:Class="NauraLauncher.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ctrl="clr-namespace:NauraLauncher.Controls"
             xmlns:cmn="clr-namespace:NauraLauncher.Common"
             xmlns:vm="clr-namespace:NauraLauncher.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="880" d:DesignWidth="1504"
             d:DataContext="{d:DesignInstance Type=vm:HomeViewModel}">

    <Grid Margin="28,4,28,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- greeting -->
            <RowDefinition Height="Auto"/>   <!-- quick stats -->
            <RowDefinition Height="*"/>      <!-- hero + intel -->
        </Grid.RowDefinitions>

        <!-- ============================================================
             GREETING
             ============================================================ -->
        <Grid Grid.Row="0" Margin="0,6,0,0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Greeting}" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="{Binding GreetingSub}" Style="{StaticResource Label}"
                           Foreground="{DynamicResource MutedForegroundBrush}" Margin="1,8,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border Style="{StaticResource Badge}" Padding="12,7" Background="{DynamicResource SurfaceBrush}">
                    <StackPanel Orientation="Horizontal">
                        <ctrl:IconControl Data="{StaticResource Icon.Clock}"
                                          Brush="{DynamicResource MutedForegroundBrush}"
                                          StrokeWidth="1.8" Width="14" Height="14" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding DateLine}" Style="{StaticResource Label}"
                                   Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Button Style="{StaticResource Button.Outline}" Padding="16,10" Margin="10,0,0,0" Cursor="Hand">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ctrl:IconControl Data="{StaticResource Icon.Bell}"
                                          Brush="{DynamicResource ForegroundBrush}"
                                          StrokeWidth="1.8" Width="15" Height="15" Margin="0,0,8,0"/>
                        <TextBlock Text="3 ALERTS" Style="{StaticResource Label}"
                                   Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ============================================================
             QUICK STAT CARDS
             ============================================================ -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding StatCards}" Margin="0,22,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Margin="0,0,14,0" Padding="18,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="42" Height="42" CornerRadius="11"
                                    Background="{DynamicResource MutedBrush}" Margin="0,0,14,0"
                                    VerticalAlignment="Center">
                                <ctrl:IconControl Data="{Binding IconKey, Converter={x:Static cmn:IconKeyConverter.Instance}}"
                                                  Brush="{DynamicResource ForegroundBrush}"
                                                  StrokeWidth="1.7" Width="20" Height="20"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Label}" Style="{StaticResource Label}"
                                           Foreground="{DynamicResource SubtleForegroundBrush}"/>
                                <TextBlock Text="{Binding Value}" FontSize="21" FontWeight="Bold"
                                           FontFamily="{DynamicResource DisplayFont}"
                                           Foreground="{DynamicResource ForegroundBrush}" Margin="0,4,0,3"/>
                                <TextBlock Text="{Binding Delta}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Label}">
                                            <Setter Property="Foreground" Value="{DynamicResource SubtleForegroundBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DeltaIsPositive}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ============================================================
             HERO + INTEL
             ============================================================ -->
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.6*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== LEFT : continue playing + library ===== -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Continue Playing hero -->
                <Border Grid.Row="0" Style="{StaticResource Card}" ClipToBounds="True" MinHeight="300">
                    <Grid>
                        <Image Source="{Binding ContinueImagePath}" Stretch="UniformToFill"
                               HorizontalAlignment="Center" VerticalAlignment="Top"/>
                        <Border>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0.0"/>
                                    <GradientStop Color="#33000000" Offset="0.45"/>
                                    <GradientStop Color="#DD07080A" Offset="0.78"/>
                                    <GradientStop Color="#FF07080A" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <Grid Margin="28">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Top labels -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <Border Style="{StaticResource Badge.Accent}" Padding="10,5">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}"
                                                 VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Text="CONTINUE PLAYING" Style="{StaticResource Label}"
                                                   Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Badge}" Padding="10,5" Margin="10,0,0,0"
                                        Background="#99000000">
                                    <TextBlock Text="{Binding ContinueStudio}" Style="{StaticResource Label}"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                </Border>
                            </StackPanel>

                            <!-- Title + mission -->
                            <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
                                <TextBlock Text="{Binding ContinueTitle}" Style="{StaticResource DisplayTitle}"
                                           FontSize="38" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <ctrl:IconControl Data="{StaticResource Icon.Target}"
                                                      Brush="{DynamicResource MutedForegroundBrush}"
                                                      StrokeWidth="1.8" Width="14" Height="14" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding ContinueMission}" Style="{StaticResource Label}"
                                               Foreground="{DynamicResource MutedForegroundBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Progress + actions -->
                            <StackPanel Grid.Row="2" Margin="0,18,0,0">
                                <Grid Margin="0,0,0,9">
                                    <TextBlock Text="{Binding ContinueProgressLabel}" Style="{StaticResource Label}"
                                               Foreground="{DynamicResource ForegroundBrush}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding ContinuePlaytime}" Style="{StaticResource Label}"
                                               HorizontalAlignment="Right"
                                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                                </Grid>

                                <Border Style="{StaticResource ProgressTrack}" Height="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding ContinueProgress, Converter={StaticResource PctGrid}}"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource ProgressFill}" Height="8"/>
                                    </Grid>
                                </Border>

                                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                    <Button Style="{StaticResource Button.Accent}" Height="46" Padding="26,0"
                                            Command="{Binding ContinueCommand}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ctrl:IconControl Data="{StaticResource Icon.Play}"
                                                              Brush="#FF06120C" Filled="True"
                                                              Width="15" Height="15" Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding ContinueCta}" FontWeight="Bold" FontSize="14"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource Button.Outline}" Height="46" Padding="22,0"
                                            Margin="12,0,0,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="MISSION LOG" Style="{StaticResource Label}"
                                                       Foreground="{DynamicResource ForegroundBrush}"
                                                       FontWeight="Bold" VerticalAlignment="Center"/>
                                            <ctrl:IconControl Data="{StaticResource Icon.ArrowRight}"
                                                              Brush="{DynamicResource MutedForegroundBrush}"
                                                              StrokeWidth="1.8" Width="14" Height="14" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Library grid (4-up) -->
                <Grid Grid.Row="1" Margin="0,18,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="2,0,2,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}"
                                     VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Installed Library" Style="{StaticResource CardHeader}"/>
                        </StackPanel>
                        <TextBlock Text="4 TITLES · 1 UPDATE PENDING" Style="{StaticResource Label}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SubtleForegroundBrush}"/>
                    </Grid>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Library}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,14,0" Padding="12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0" Height="96" CornerRadius="10" ClipToBounds="True">
                                            <Grid>
                                                <Image Source="{Binding ImagePath}" Stretch="UniformToFill"/>
                                                <Border>
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#59000000" Offset="0"/>
                                                            <GradientStop Color="#00000000" Offset="0.5"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                                <Button Style="{StaticResource Button.Icon}" Width="28" Height="28"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                                                        Background="#B3000000" ToolTip="Play"
                                                        Command="{Binding DataContext.PlayCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <ctrl:IconControl Data="{StaticResource Icon.Play}"
                                                                      Brush="{DynamicResource ForegroundBrush}" Filled="True"
                                                                      Width="12" Height="12"/>
                                                </Button>
                                            </Grid>
                                        </Border>

                                        <TextBlock Grid.Row="1" Text="{Binding Title}" Style="{StaticResource Label}"
                                                   Foreground="{DynamicResource ForegroundBrush}" FontWeight="Bold"
                                                   FontSize="12" Margin="2,12,0,4" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Row="2" Text="{Binding Playtime}" Style="{StaticResource Label}"
                                                   Margin="2,0,0,0"
                                                   Foreground="{DynamicResource SubtleForegroundBrush}"/>

                                        <StackPanel Grid.Row="3" Margin="2,12,0,2">
                                            <Border Style="{StaticResource ProgressTrack}" Height="4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{Binding Progress, Converter={StaticResource PctGrid}}"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Style="{StaticResource ProgressFill}" Height="4"/>
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="{Binding Status}"
                                                       Margin="0,9,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Label}">
                                                        <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StatusIsAccent}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Grid>

            <!-- ===== RIGHT : latest intel ===== -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}"
                                     VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Latest Intel" Style="{StaticResource CardHeader}"/>
                        </StackPanel>
                        <Border Style="{StaticResource Badge.Accent}" HorizontalAlignment="Right" Padding="9,4">
                            <TextBlock Text="LIVE FEED" Style="{StaticResource Label}" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding NewsItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                                            Padding="0,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Rectangle Grid.Column="0" Width="3" RadiusX="1.5" RadiusY="1.5"
                                                       VerticalAlignment="Stretch" Margin="0,2,14,2"
                                                       Fill="{Binding ToneHex, Converter={StaticResource HexBrush}}"/>

                                            <StackPanel Grid.Column="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Category}" Style="{StaticResource Label}"
                                                               FontWeight="Bold"
                                                               Foreground="{Binding ToneHex, Converter={StaticResource HexBrush}}"/>
                                                    <Ellipse Width="5" Height="5" Margin="8,0,0,0"
                                                             VerticalAlignment="Center"
                                                             Fill="{DynamicResource AccentBrush}"
                                                             Visibility="{Binding IsLive, Converter={StaticResource BoolVis}}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource ForegroundBrush}"
                                                           TextWrapping="Wrap" Margin="0,7,0,6"/>
                                                <TextBlock Text="{Binding Meta}" Style="{StaticResource Label}"
                                                           Foreground="{DynamicResource SubtleForegroundBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Button Grid.Row="2" Style="{StaticResource Button.Ghost}" Padding="0" Margin="0,14,0,0"
                            HorizontalAlignment="Left" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="ALL DISPATCHES" Style="{StaticResource Label}" FontWeight="Bold"
                                       Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"/>
                            <ctrl:IconControl Data="{StaticResource Icon.ArrowRight}"
                                              Brush="{DynamicResource MutedForegroundBrush}"
                                              StrokeWidth="1.8" Width="14" Height="14" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
