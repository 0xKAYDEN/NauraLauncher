<UserControl x:Class="NauraLauncher.Views.MarketplacePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ctrl="clr-namespace:NauraLauncher.Controls"
             xmlns:cmn="clr-namespace:NauraLauncher.Common"
             xmlns:vm="clr-namespace:NauraLauncher.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="880" d:DesignWidth="1504"
             d:DataContext="{d:DesignInstance Type=vm:MarketplaceViewModel}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- toolbar -->
            <RowDefinition Height="*" />      <!-- hero + curated archives -->
        </Grid.RowDefinitions>

        <!-- ============================================================
             TOOLBAR : category chips + sort/filter
             ============================================================ -->
        <Grid Grid.Row="0" Margin="28,8,28,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ItemsControl Grid.Column="0" ItemsSource="{Binding Categories}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Name}" Margin="0,0,10,0" Cursor="Hand"
                                Command="{Binding DataContext.SelectCategoryCommand,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Button.Outline}">
                                    <Setter Property="Padding" Value="18,10"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="SORT:" Style="{StaticResource Label}" VerticalAlignment="Center"
                           Foreground="{DynamicResource SubtleForegroundBrush}" Margin="0,0,8,0"/>
                <Button Style="{StaticResource Button.Ghost}" Padding="0" Cursor="Hand">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SortLabel}" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center"/>
                        <ctrl:IconControl Data="{StaticResource Icon.ChevronDown}"
                                          Brush="{DynamicResource MutedForegroundBrush}"
                                          StrokeWidth="1.8" Width="15" Height="15" Margin="6,1,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Button.Icon}" Margin="16,0,0,0" ToolTip="Filters">
                    <ctrl:IconControl Data="{StaticResource Icon.Sliders}"
                                      Brush="{DynamicResource ForegroundBrush}"
                                      StrokeWidth="1.8" Width="17" Height="17"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ============================================================
             CONTENT : hero (left) + curated archives (right)
             ============================================================ -->
        <Grid Grid.Row="1" Margin="28,0,28,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== LEFT : hero column ===== -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Hero card -->
                <Border Grid.Row="0" Style="{StaticResource Card}" ClipToBounds="True">
                    <Grid>
                        <!-- Background art -->
                        <Image Source="{Binding Feature.HeroImage}" Stretch="UniformToFill"
                               HorizontalAlignment="Center" VerticalAlignment="Top"/>
                        <!-- Gradient scrims -->
                        <Border>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0.0"/>
                                    <GradientStop Color="#22000000" Offset="0.45"/>
                                    <GradientStop Color="#CC07080A" Offset="0.72"/>
                                    <GradientStop Color="#FF07080A" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <Grid Margin="30">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Top labels -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <TextBlock Text="{Binding Feature.SpotlightLabel}"
                                           Style="{StaticResource Label}"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           FontWeight="Bold"/>
                                <StackPanel Orientation="Horizontal" Margin="16,0,0,0">
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}"
                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Feature.LiveLabel}"
                                               Style="{StaticResource Label}"
                                               Foreground="{DynamicResource AccentBrush}"
                                               FontWeight="Bold"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Item index chip -->
                            <Border Grid.Row="1" Style="{StaticResource Badge}"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Background="#99000000" Padding="12,7">
                                <TextBlock Text="{Binding Feature.ItemIndex}"
                                           Style="{StaticResource Label}"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           FontFamily="{DynamicResource MonoFont}"/>
                            </Border>

                            <!-- Bottom info -->
                            <StackPanel Grid.Row="2" Margin="0,18,0,0">
                                <Grid Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Feature.Studio}"
                                                   Style="{StaticResource Label}"
                                                   Foreground="{DynamicResource MutedForegroundBrush}"/>
                                        <Ellipse Width="4" Height="4" Fill="{DynamicResource SubtleForegroundBrush}"
                                                 VerticalAlignment="Center" Margin="9,0"/>
                                        <TextBlock Text="{Binding Feature.Build}"
                                                   Style="{StaticResource Label}"
                                                   Foreground="{DynamicResource MutedForegroundBrush}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <ctrl:IconControl Data="{StaticResource Icon.Star}"
                                                          Brush="{DynamicResource AccentBrush}" Filled="True"
                                                          Width="14" Height="14" Margin="0,0,7,0"/>
                                        <TextBlock Text="{Binding Feature.RatingText}"
                                                   Style="{StaticResource Label}"
                                                   Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="{Binding Feature.Title}" Style="{StaticResource DisplayTitle}"
                                           Margin="0,0,0,10"/>

                                <TextBlock Text="{Binding Feature.Description}" Style="{StaticResource Body}"
                                           MaxWidth="720" HorizontalAlignment="Left" Margin="0,0,0,20"/>

                                <!-- Actions row -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Edition toggle -->
                                    <Border Grid.Column="0" Background="#66000000"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="25" Padding="5" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="{DynamicResource ElevatedBrush}"
                                                    CornerRadius="20" Padding="16,8">
                                                <TextBlock Text="{Binding Feature.EditionPrimary}"
                                                           FontWeight="SemiBold" FontSize="13"
                                                           Foreground="{DynamicResource ForegroundBrush}"/>
                                            </Border>
                                            <TextBlock Text="{Binding Feature.EditionSecondary}"
                                                       FontWeight="Medium" FontSize="13" Margin="16,0,14,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Price + buttons -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Feature.OldPrice}" FontSize="14"
                                                   Foreground="{DynamicResource SubtleForegroundBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock.TextDecorations>
                                                <TextDecorationCollection>
                                                    <TextDecoration Location="Strikethrough"/>
                                                </TextDecorationCollection>
                                            </TextBlock.TextDecorations>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Feature.Price}" FontSize="26" FontWeight="Bold"
                                                   FontFamily="{DynamicResource DisplayFont}"
                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                   VerticalAlignment="Center"/>
                                        <Border Style="{StaticResource Badge.Accent}" Margin="10,0,0,0" Padding="8,4">
                                            <TextBlock Text="{Binding Feature.Discount}" FontWeight="Bold" FontSize="12"
                                                       Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>

                                        <Button Style="{StaticResource Button.Icon}" Width="46" Height="46"
                                                Margin="18,0,10,0" ToolTip="Bookmark">
                                            <ctrl:IconControl Data="{StaticResource Icon.Bookmark}"
                                                              Brush="{DynamicResource ForegroundBrush}"
                                                              StrokeWidth="1.7" Width="18" Height="18"/>
                                        </Button>

                                        <Button Style="{StaticResource Button.Primary}" Height="46" Padding="24,0"
                                                Command="{Binding PreOrderCommand}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <ctrl:IconControl Data="{StaticResource Icon.Bookmark}"
                                                                  Brush="{DynamicResource PrimaryForegroundBrush}"
                                                                  StrokeWidth="1.7" Width="16" Height="16" Margin="0,0,9,0"/>
                                                <TextBlock Text="{Binding Feature.PreOrderLabel}"
                                                           FontWeight="SemiBold" FontSize="14"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Status tiles -->
                <ItemsControl Grid.Row="1" ItemsSource="{Binding StatusTiles}" Margin="0,18,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,14,0" Padding="18,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10"
                                            Background="{DynamicResource MutedBrush}" Margin="0,0,14,0">
                                        <ctrl:IconControl Data="{Binding IconKey, Converter={x:Static cmn:IconKeyConverter.Instance}}"
                                                          Brush="{DynamicResource ForegroundBrush}"
                                                          StrokeWidth="1.7" Width="20" Height="20"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Category}" Style="{StaticResource Label}"
                                                   Foreground="{DynamicResource SubtleForegroundBrush}"/>
                                        <TextBlock Text="{Binding Detail}" FontWeight="SemiBold" FontSize="14"
                                                   Foreground="{DynamicResource ForegroundBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding State}" Style="{StaticResource Label}"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!-- ===== RIGHT : curated archives ===== -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,2,0,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}"
                                 VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Curated Archives" Style="{StaticResource SectionTitle}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding ArchivesShowing}" Style="{StaticResource Label}"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               Foreground="{DynamicResource SubtleForegroundBrush}"/>
                </Grid>

                <ItemsControl Grid.Row="1" ItemsSource="{Binding Archives}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,14,14" Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Thumbnail -->
                                    <Border Grid.Row="0" CornerRadius="10" ClipToBounds="True" Height="150">
                                        <Grid>
                                            <Image Source="{Binding ImagePath}" Stretch="UniformToFill"/>
                                            <Border>
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#66000000" Offset="0"/>
                                                        <GradientStop Color="#00000000" Offset="0.4"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <!-- Ribbon -->
                                            <Border Style="{StaticResource Badge}" Margin="10"
                                                    HorizontalAlignment="Left" VerticalAlignment="Top"
                                                    Background="#B3000000" Padding="9,5">
                                                <TextBlock Text="{Binding Ribbon}"
                                                           FontWeight="Bold" FontSize="10">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Label}">
                                                            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding RibbonIsAccent}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <!-- Bookmark -->
                                            <Button Style="{StaticResource Button.Icon}" Width="30" Height="30"
                                                    Margin="10" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Background="#B3000000" ToolTip="Save">
                                                <ctrl:IconControl Data="{StaticResource Icon.Bookmark}"
                                                                  Brush="{DynamicResource ForegroundBrush}"
                                                                  StrokeWidth="1.7" Width="14" Height="14"/>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- Studio + release -->
                                    <Grid Grid.Row="1" Margin="4,14,4,0">
                                        <TextBlock Text="{Binding Studio}" Style="{StaticResource Label}"
                                                   Foreground="{DynamicResource SubtleForegroundBrush}"/>
                                        <TextBlock Text="{Binding ReleaseTag}" Style="{StaticResource Label}"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource SubtleForegroundBrush}"/>
                                    </Grid>

                                    <!-- Title -->
                                    <TextBlock Grid.Row="2" Text="{Binding Title}" Style="{StaticResource CardTitle}"
                                               Margin="4,6,4,0"/>

                                    <!-- Price + details -->
                                    <Grid Grid.Row="3" Margin="4,18,4,4">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Price}" FontWeight="Bold" FontSize="15"
                                                       FontFamily="{DynamicResource MonoFont}"
                                                       Foreground="{DynamicResource ForegroundBrush}"/>
                                            <Border Style="{StaticResource Badge.Accent}" Margin="8,0,0,0" Padding="6,3"
                                                    Visibility="{Binding Discount, Converter={StaticResource StrVis}}">
                                                <TextBlock Text="{Binding Discount}" FontWeight="Bold" FontSize="11"
                                                           Foreground="{DynamicResource AccentBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <Button HorizontalAlignment="Right" Style="{StaticResource Button.Ghost}"
                                                Padding="0" Cursor="Hand">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="DETAILS" Style="{StaticResource Label}"
                                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                                           FontWeight="Bold" VerticalAlignment="Center"/>
                                                <ctrl:IconControl Data="{StaticResource Icon.ArrowRight}"
                                                                  Brush="{DynamicResource MutedForegroundBrush}"
                                                                  StrokeWidth="1.8" Width="14" Height="14" Margin="7,0,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
