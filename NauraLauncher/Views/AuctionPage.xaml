<UserControl x:Class="NauraLauncher.Views.AuctionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ctrl="clr-namespace:NauraLauncher.Controls"
             xmlns:cmn="clr-namespace:NauraLauncher.Common"
             xmlns:vm="clr-namespace:NauraLauncher.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="880" d:DesignWidth="1504"
             d:DataContext="{d:DesignInstance Type=vm:AuctionViewModel}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar with tabs -->
        <Grid Grid.Row="0" Margin="28,8,28,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <!-- Tabs -->
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="25" Padding="5" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="BROWSE AUCTIONS" Padding="16,8" Cursor="Hand" Command="{Binding SwitchTabCommand}" CommandParameter="Browse">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBrowseTab}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource ElevatedBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="MY LOTS" Padding="16,8" Cursor="Hand" Margin="4,0,0,0" Command="{Binding SwitchTabCommand}" CommandParameter="MyLots">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMyLotsTab}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource ElevatedBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="SELL" Padding="16,8" Cursor="Hand" Margin="4,0,0,0" Command="{Binding SwitchTabCommand}" CommandParameter="Sell">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSellTab}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="Foreground" Value="#FF06120C"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Rarity filters - only in browse -->
                <ItemsControl ItemsSource="{Binding RarityFilters}" VerticalAlignment="Center" Visibility="{Binding IsBrowseTab, Converter={StaticResource BoolVis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="0,0,6,0" Cursor="Hand"
                                    Command="{Binding DataContext.SelectRarityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Button.Outline}">
                                        <Setter Property="Padding" Value="14,8"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background" Value="{Binding ToneHex, Converter={StaticResource HexBrush}}"/>
                                                <Setter Property="Foreground" Value="#FF0A0B0D"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="{Binding Name}"/>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Label}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,12,0" Visibility="{Binding StatusMessage, Converter={StaticResource StrVis}}"/>
                <Border Style="{StaticResource Badge.Accent}" Padding="10,6">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="AUCTION OPEN • 148 LOTS" Style="{StaticResource Label}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" FontSize="11"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- BROWSE TAB CONTENT -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsBrowseTab, Converter={StaticResource BoolVis}}">
            <StackPanel Margin="28,0,28,24">

                <!-- Summary cards -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0" Padding="18,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Background="#2634D399" Margin="0,0,12,0">
                                <ctrl:IconControl Data="{StaticResource Icon.Gold}" Brush="{DynamicResource AccentBrush}" Width="20" Height="20"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding EscrowPoolLabel}" Style="{StaticResource Label}" FontSize="10"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding EscrowPoolValue}" FontSize="18" FontWeight="Bold" FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBlock Text="{Binding EscrowPoolDelta}" Style="{StaticResource Label}" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="10"/>
                                </StackPanel>
                                <TextBlock Text="{Binding EscrowPoolMeta}" Style="{StaticResource Label}" FontSize="10" Foreground="{DynamicResource SubtleForegroundBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,12,0" Padding="18,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Background="{DynamicResource MutedBrush}" Margin="0,0,12,0">
                                <ctrl:IconControl Data="{StaticResource Icon.Eye}" Brush="{DynamicResource ForegroundBrush}" Width="20" Height="20"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding WatchlistLabel}" Style="{StaticResource Label}" FontSize="10"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding WatchlistValue}" FontSize="18" FontWeight="Bold" FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBlock Text="{Binding WatchlistDelta}" Style="{StaticResource Label}" Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="10"/>
                                </StackPanel>
                                <TextBlock Text="{Binding WatchlistMeta}" Style="{StaticResource Label}" FontSize="10" Foreground="{DynamicResource SubtleForegroundBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Background="{DynamicResource MutedBrush}" Margin="0,0,12,0">
                                <ctrl:IconControl Data="{StaticResource Icon.Trophy}" Brush="{DynamicResource ForegroundBrush}" Width="20" Height="20"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding LotsWonLabel}" Style="{StaticResource Label}" FontSize="10"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding LotsWonValue}" FontSize="18" FontWeight="Bold" FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBlock Text="{Binding LotsWonDelta}" Style="{StaticResource Label}" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="10"/>
                                </StackPanel>
                                <TextBlock Text="{Binding LotsWonMeta}" Style="{StaticResource Label}" FontSize="10" Foreground="{DynamicResource SubtleForegroundBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Main auction grid -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Lots list + details -->
                    <StackPanel Grid.Column="0">
                        <!-- Lots List -->
                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="ACTIVE LOTS - DRAGON BALLS, GEMS, SUPER GEAR" Style="{StaticResource PanelTitle}" Margin="0,0,0,12"/>
                                <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding AuctionLots}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,8" Padding="10" CornerRadius="8" Cursor="Hand" Background="{DynamicResource SurfaceBrush}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Value="True">
                                                                    <DataTrigger.Binding>
                                                                        <MultiBinding Converter="{x:Static cmn:EqualityConverter.Instance}">
                                                                            <Binding/>
                                                                            <Binding Path="DataContext.SelectedLot" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                                        </MultiBinding>
                                                                    </DataTrigger.Binding>
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                                    <Setter Property="BorderThickness" Value="2"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="50"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Width="50" Height="50" CornerRadius="8" ClipToBounds="True">
                                                            <Image Source="{Binding Item.ImagePath}" Stretch="UniformToFill"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Item.Name}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ForegroundBrush}" TextTrimming="CharacterEllipsis"/>
                                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                <TextBlock Text="{Binding CurrentBid, StringFormat='{}{0} CPs'}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentBrush}"/>
                                                                <TextBlock Text="{Binding BidCount, StringFormat=' • {0} bids'}" Style="{StaticResource Label}" FontSize="10" Margin="6,0,0,0"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding TimeRemaining, StringFormat='{}{0:hh\\:mm}'}" FontFamily="{DynamicResource MonoFont}" FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}"/>
                                                            <Border Style="{StaticResource Badge}" Padding="6,2" Margin="0,4,0,0" Background="#2634D399">
                                                                <TextBlock Text="{Binding Item.Rarity}" FontSize="9" FontWeight="Bold" Foreground="{Binding Item.GetRarityHex, Converter={StaticResource HexBrush}}"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <Button Grid.Column="0" Grid.ColumnSpan="3" Opacity="0" Command="{Binding DataContext.SelectLotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <!-- Live lot card -->
                        <Border Style="{StaticResource Card}" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="200"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Image Source="{Binding LotImagePath}" Stretch="UniformToFill"/>
                                    <Border>
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#00000000" Offset="0.0"/>
                                                <GradientStop Color="#EE07080A" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>

                                    <Border Style="{StaticResource Badge.Accent}" Margin="14" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="10,5">
                                        <StackPanel Orientation="Horizontal">
                                            <ctrl:IconControl Data="{StaticResource Icon.Shield}" Brush="{DynamicResource AccentBrush}" Width="14" Height="14" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding LotCertifiedLabel}" Style="{StaticResource Label}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" FontSize="11"/>
                                            <TextBlock Text="{Binding LotCertifiedId}" Style="{StaticResource Label}" FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource AccentBrush}" Margin="6,0,0,0" FontSize="10"/>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Orientation="Horizontal" Margin="14" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <Border Style="{StaticResource Badge}" Padding="8,4" Background="#B3000000">
                                            <TextBlock Text="{Binding LotRarity}" Style="{StaticResource Label}" FontWeight="Bold" Foreground="{Binding LotToneHex, Converter={StaticResource HexBrush}}" FontSize="11"/>
                                        </Border>
                                    </StackPanel>

                                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="14" Background="#CC000000" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="20" Padding="12,8">
                                        <StackPanel Orientation="Horizontal">
                                            <ctrl:IconControl Data="{StaticResource Icon.Hourglass}" Brush="{DynamicResource AccentBrush}" Width="14" Height="14" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Countdown}" FontSize="14" FontWeight="Bold" FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource AccentBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <StackPanel Grid.Row="1" Margin="20,16">
                                    <TextBlock Text="{Binding LotSerial}" Style="{StaticResource Label}" FontFamily="{DynamicResource MonoFont}" Foreground="{Binding LotToneHex, Converter={StaticResource HexBrush}}" FontWeight="Bold" FontSize="11"/>
                                    <TextBlock Text="{Binding LotName}" Style="{StaticResource SectionTitle}" FontSize="22" Margin="0,6,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <ctrl:IconControl Data="{StaticResource Icon.Dragon}" Brush="{DynamicResource MutedForegroundBrush}" Width="14" Height="14" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding LotProvenance}" Style="{StaticResource Label}" Foreground="{DynamicResource MutedForegroundBrush}" FontSize="11"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Attributes -->
                        <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,14,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <ctrl:IconControl Data="{StaticResource Icon.Sword}" Brush="{DynamicResource ForegroundBrush}" Width="16" Height="16" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding ProvenanceTitle}" Style="{StaticResource PanelTitle}" FontSize="12"/>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Attributes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource Label}" FontSize="11"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Right: Bid Panel -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,16" VerticalAlignment="Top">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="LIVE BID PANEL - CONQUER AUCTION" Style="{StaticResource PanelTitle}" FontSize="12"/>
                            </StackPanel>

                            <TextBlock Text="CURRENT BID" Style="{StaticResource Label}" FontSize="10"/>
                            <TextBlock Text="{Binding CurrentBid}" FontSize="32" FontWeight="Bold" FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource ForegroundBrush}" Margin="0,4,0,2"/>
                            <TextBlock Text="{Binding CurrentBidMeta}" Style="{StaticResource Label}" FontSize="11"/>

                            <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,14"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="{DynamicResource MutedBrush}" Margin="0,0,10,0">
                                    <ctrl:IconControl Data="{StaticResource Icon.User}" Brush="{DynamicResource MutedForegroundBrush}" Width="18" Height="18"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="TOP BIDDER" Style="{StaticResource Label}" FontSize="10"/>
                                    <TextBlock Text="{Binding TopBidder}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource ForegroundBrush}" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding TopBidderMeta}" Style="{StaticResource Label}" FontSize="10"/>
                                </StackPanel>
                            </Grid>

                            <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,14"/>

                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="BUYOUT" Style="{StaticResource Label}" FontSize="10"/>
                                    <TextBlock Text="{Binding Buyout}" FontSize="18" FontWeight="Bold" FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource ForegroundBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding BidProgressLabel}" Style="{StaticResource Label}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" FontSize="10"/>
                            </Grid>

                            <Border Style="{StaticResource ProgressTrack}" Margin="0,10,0,0" Height="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding BidProgress, Converter={StaticResource PctGrid}}"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource ProgressFill}" Height="6"/>
                                </Grid>
                            </Border>

                            <TextBlock Text="BID INCREMENT" Style="{StaticResource Label}" FontSize="10" Margin="0,14,0,8"/>
                            <ItemsControl ItemsSource="{Binding Increments}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="0,0,6,0" Cursor="Hand" Command="{Binding DataContext.SelectIncrementCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource Button.Outline}">
                                                    <Setter Property="Padding" Value="0,8"/>
                                                    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
                                                    <Setter Property="FontSize" Value="11"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ElevatedBrush}"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock Text="{Binding Label}" HorizontalAlignment="Center"/>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Style="{StaticResource Button.Accent}" Height="46" Margin="0,16,0,0" Command="{Binding PlaceBidCommand}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <ctrl:IconControl Data="{StaticResource Icon.Gavel}" Brush="#FF06120C" Width="16" Height="16" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding PlaceBidLabel}" FontWeight="Bold" FontSize="12"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource Button.Outline}" Height="42" Margin="0,8,0,0" Command="{Binding BuyoutCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <ctrl:IconControl Data="{StaticResource Icon.Gold}" Brush="{DynamicResource ForegroundBrush}" Width="14" Height="14" Margin="0,0,8,0"/>
                                    <TextBlock Text="BUYOUT NOW" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource ForegroundBrush}"/>
                                </StackPanel>
                            </Button>

                            <Button Height="40" Margin="0,8,0,0" Command="{Binding WatchCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Button.Outline}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWatching}" Value="True">
                                                <Setter Property="Background" Value="#2634D399"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="{Binding WatchLabel}" FontWeight="Bold" FontSize="11"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- MY LOTS TAB -->
        <Grid Grid.Row="1" Margin="28,0,28,0" Visibility="{Binding IsMyLotsTab, Converter={StaticResource BoolVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="MY AUCTION LOTS &amp; BIDS" Style="{StaticResource SectionTitle}" Margin="0,0,0,16"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="MY ACTIVE LOTS" Style="{StaticResource PanelTitle}" Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding MyLots}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Width="300" Margin="0,0,14,14" Padding="14">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="50" Height="50" CornerRadius="8" ClipToBounds="True">
                                                <Image Source="{Binding Item.ImagePath}" Stretch="UniformToFill"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Item.Name}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ForegroundBrush}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding CurrentBid, StringFormat='Current: {0} CPs'}" Style="{StaticResource Label}" FontSize="11" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                        <Button Style="{StaticResource Button.Outline}" Height="36" Margin="0,12,0,0" Command="{Binding DataContext.CancelAuctionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <TextBlock Text="CANCEL AUCTION" FontSize="11" Foreground="{DynamicResource DestructiveBrush}"/>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="MY BIDS" Style="{StaticResource PanelTitle}" Margin="0,24,0,12"/>
                    <ItemsControl ItemsSource="{Binding MyBids}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Width="300" Margin="0,0,14,14" Padding="14" Background="{DynamicResource SurfaceBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="50" Height="50" CornerRadius="8" ClipToBounds="True">
                                            <Image Source="{Binding Item.ImagePath}" Stretch="UniformToFill"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Item.Name}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ForegroundBrush}"/>
                                            <TextBlock Text="{Binding CurrentBid, StringFormat='Your bid: {0} CPs'}" Style="{StaticResource Label}" FontSize="11" Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding TimeRemaining, StringFormat='Ends in {0:hh\\:mm}'}" Style="{StaticResource Label}" FontSize="10" Foreground="{DynamicResource SubtleForegroundBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- SELL TAB -->
        <Grid Grid.Row="1" Margin="28,0,28,0" Visibility="{Binding IsSellTab, Converter={StaticResource BoolVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="SELECT ITEM TO AUCTION" Style="{StaticResource PanelTitle}" Margin="0,0,0,16"/>
                    <ItemsControl ItemsSource="{Binding TradableInventory}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="160" Margin="0,0,12,12" Padding="10">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                            <Style.Triggers>
                                                <DataTrigger Value="True">
                                                    <DataTrigger.Binding>
                                                        <MultiBinding Converter="{x:Static cmn:EqualityConverter.Instance}">
                                                            <Binding/>
                                                            <Binding Path="DataContext.SelectedInventoryItem" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                        </MultiBinding>
                                                    </DataTrigger.Binding>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" Height="70" CornerRadius="8" ClipToBounds="True">
                                            <Image Source="{Binding ImagePath}" Stretch="UniformToFill"/>
                                        </Border>
                                        <TextBlock Grid.Row="1" Text="{Binding Name}" FontWeight="Bold" FontSize="10" Foreground="{DynamicResource ForegroundBrush}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Row="0" Grid.RowSpan="2" Opacity="0" Command="{Binding DataContext.SelectInventoryForAuctionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="CREATE AUCTION LOT" Style="{StaticResource PanelTitle}" Margin="0,0,0,16"/>

                    <StackPanel Visibility="{Binding SelectedInventoryItem, Converter={StaticResource BoolVis}}">
                        <Border Height="100" CornerRadius="8" ClipToBounds="True" Margin="0,0,0,12">
                            <Image Source="{Binding SelectedInventoryItem.ImagePath}" Stretch="UniformToFill"/>
                        </Border>
                        <TextBlock Text="{Binding SelectedInventoryItem.Name}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource ForegroundBrush}"/>
                        <TextBlock Text="{Binding SelectedInventoryItem.Description}" Style="{StaticResource Body}" FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}" TextWrapping="Wrap" Margin="0,6,0,16"/>

                        <TextBlock Text="STARTING PRICE" Style="{StaticResource Label}" FontWeight="Bold" FontSize="10" Margin="0,0,0,6"/>
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Height="40" Margin="0,0,0,12">
                            <TextBox Text="{Binding StartingPrice, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Margin="12,0" Foreground="{DynamicResource ForegroundBrush}" FontFamily="{DynamicResource MonoFont}"/>
                        </Border>

                        <TextBlock Text="BUYOUT PRICE" Style="{StaticResource Label}" FontWeight="Bold" FontSize="10" Margin="0,0,0,6"/>
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Height="40" Margin="0,0,0,16">
                            <TextBox Text="{Binding BuyoutPrice, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Margin="12,0" Foreground="{DynamicResource ForegroundBrush}" FontFamily="{DynamicResource MonoFont}"/>
                        </Border>

                        <TextBlock Text="CURRENCY" Style="{StaticResource Label}" FontWeight="Bold" FontSize="10" Margin="0,0,0,6"/>
                        <Border Style="{StaticResource Segmented.Container}" Margin="0,0,0,20">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segmented.Item}" Content="CPs" IsChecked="{Binding AuctionCurrency, Converter={StaticResource ParamMatch}, ConverterParameter=Cps}"/>
                                <RadioButton Style="{StaticResource Segmented.Item}" Content="Gold" IsChecked="{Binding AuctionCurrency, Converter={StaticResource ParamMatch}, ConverterParameter=Gold}"/>
                            </StackPanel>
                        </Border>

                        <Button Style="{StaticResource Button.Accent}" Height="44" Command="{Binding CreateAuctionCommand}">
                            <TextBlock Text="CREATE AUCTION" FontWeight="Bold" FontSize="12"/>
                        </Button>
                    </StackPanel>

                    <TextBlock Text="Select an item to auction. Auction lasts 3 days. Only unbound tradable items allowed." Style="{StaticResource Label}" Foreground="{DynamicResource SubtleForegroundBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,30,0,0" Visibility="{Binding SelectedInventoryItem, Converter={StaticResource BoolVis}, ConverterParameter=invert}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
